{
  "name": "nextbus-hk",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:edge": "pnpm --filter @nextbus/edge dev",
    "dev:mobile": "pnpm --filter @nextbus/mobile dev",
    "dev:web": "pnpm --filter @nextbus/mobile exec expo start --web",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run boundaries",
    "boundaries": "pnpm run boundaries:check && pnpm run boundaries:selftest && pnpm run check:no-adhoc-id-parsing && pnpm run check:vm-no-styling:selftest && pnpm run check:vm-no-styling && pnpm run check:no-raw-colours",
    "boundaries:gen": "node scripts/boundaries/generate.mjs",
    "boundaries:check": "node scripts/boundaries/check.mjs",
    "boundaries:selftest": "node scripts/boundaries/selftest.mjs",
    "clean": "git clean -xdf node_modules dist .turbo .expo .wrangler",
    "dataset:build": "pnpm --filter @nextbus/edge dataset:build",
    "dataset:publish": "pnpm --filter @nextbus/edge dataset:publish",
    "study:gmb-names": "pnpm --filter @nextbus/edge exec node --import tsx scripts/studies/gmb-name-matching.mts",
    "check:no-adhoc-id-parsing": "node scripts/check-no-adhoc-id-parsing.mjs",
    "check:vm-no-styling": "node scripts/check-vm-no-styling.mjs",
    "check:vm-no-styling:selftest": "node scripts/check-vm-no-styling.mjs --selftest",
    "check:no-raw-colours": "node scripts/check-no-raw-colours.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "dependency-cruiser": "18.1.0",
    "tsx": "^4.23.1",
    "turbo": "2.9.16",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "workerd",
      "@swc/core",
      "sharp",
      "@parcel/watcher",
      "bufferutil",
      "utf-8-validate"
    ],
    "overrides": {
      "esbuild": "0.27.3"
    }
  }
}
