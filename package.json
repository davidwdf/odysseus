{
  "name": "nextbus-hk",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:edge": "pnpm --filter @nextbus/edge dev",
    "dev:mobile": "pnpm --filter @nextbus/mobile dev",
    "dev:web": "pnpm --filter @nextbus/mobile exec expo start --web",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "git clean -xdf node_modules dist .turbo .expo .wrangler",
    "dataset:build": "pnpm --filter @nextbus/edge dataset:build",
    "dataset:publish": "pnpm --filter @nextbus/edge dataset:publish",
    "study:gmb-names": "pnpm --filter @nextbus/edge exec node --import tsx scripts/studies/gmb-name-matching.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "tsx": "^4.23.1",
    "turbo": "2.9.16",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "workerd",
      "@swc/core",
      "sharp",
      "@parcel/watcher",
      "bufferutil",
      "utf-8-validate"
    ],
    "overrides": {
      "esbuild": "0.27.3"
    }
  }
}
