{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.context",
      "!**/*.gen.ts",
      "!packages/contract/openapi.json",
      "!packages/contract/asyncapi.json",
      "!scripts/boundaries/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": ["tailwind"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/contract/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nextbus/ports",
                      "@nextbus/core",
                      "@nextbus/ui",
                      "@nextbus/i18n",
                      "@nextbus/api-client",
                      "@nextbus/data-normalize",
                      "@nextbus/edge",
                      "@nextbus/mobile",
                      "@nextbus/web",
                      "react*",
                      "expo*",
                      "@expo/*",
                      "nativewind*",
                      "zustand",
                      "@tanstack/*",
                      "lucide-*"
                    ],
                    "message": "not importable from contract — boundary declared in layers.json (ADR-051)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ports/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nextbus/contract",
                      "@nextbus/core",
                      "@nextbus/ui",
                      "@nextbus/i18n",
                      "@nextbus/api-client",
                      "@nextbus/data-normalize",
                      "@nextbus/edge",
                      "@nextbus/mobile",
                      "@nextbus/web",
                      "react*",
                      "expo*",
                      "@expo/*",
                      "nativewind*",
                      "zustand",
                      "@tanstack/*",
                      "lucide-*"
                    ],
                    "message": "not importable from ports — boundary declared in layers.json (ADR-051)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nextbus/ports",
                      "@nextbus/ui",
                      "@nextbus/i18n",
                      "@nextbus/api-client",
                      "@nextbus/data-normalize",
                      "@nextbus/edge",
                      "@nextbus/mobile",
                      "@nextbus/web",
                      "react*",
                      "expo*",
                      "@expo/*",
                      "nativewind*",
                      "zustand",
                      "@tanstack/*",
                      "lucide-*"
                    ],
                    "message": "not importable from kernel — boundary declared in layers.json (ADR-051)"
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "no fetch in kernel — boundary declared in layers.json (ADR-051)",
                  "crypto": "no crypto in kernel — boundary declared in layers.json (ADR-051)",
                  "Intl": "no Intl in kernel — boundary declared in layers.json (ADR-051)",
                  "localStorage": "no localStorage in kernel — boundary declared in layers.json (ADR-051)",
                  "sessionStorage": "no sessionStorage in kernel — boundary declared in layers.json (ADR-051)",
                  "navigator": "no navigator in kernel — boundary declared in layers.json (ADR-051)",
                  "window": "no window in kernel — boundary declared in layers.json (ADR-051)",
                  "document": "no document in kernel — boundary declared in layers.json (ADR-051)",
                  "process": "no process in kernel — boundary declared in layers.json (ADR-051)",
                  "performance": "no performance in kernel — boundary declared in layers.json (ADR-051)",
                  "setTimeout": "no setTimeout in kernel — boundary declared in layers.json (ADR-051)",
                  "setInterval": "no setInterval in kernel — boundary declared in layers.json (ADR-051)",
                  "XMLHttpRequest": "no XMLHttpRequest in kernel — boundary declared in layers.json (ADR-051)",
                  "WebSocket": "no WebSocket in kernel — boundary declared in layers.json (ADR-051)"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/**", "packages/i18n/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nextbus/ports",
                      "@nextbus/api-client",
                      "@nextbus/data-normalize",
                      "@nextbus/edge",
                      "@nextbus/mobile",
                      "@nextbus/web",
                      "react*",
                      "expo*",
                      "@expo/*",
                      "nativewind*",
                      "zustand",
                      "@tanstack/*",
                      "lucide-*"
                    ],
                    "message": "not importable from tokens — boundary declared in layers.json (ADR-051)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/api-client/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nextbus/ui",
                      "@nextbus/i18n",
                      "@nextbus/data-normalize",
                      "@nextbus/edge",
                      "@nextbus/mobile",
                      "@nextbus/web",
                      "react*",
                      "expo*",
                      "@expo/*",
                      "nativewind*",
                      "zustand",
                      "@tanstack/*",
                      "lucide-*"
                    ],
                    "message": "not importable from client — boundary declared in layers.json (ADR-051)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/data-normalize/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nextbus/ports",
                      "@nextbus/ui",
                      "@nextbus/i18n",
                      "@nextbus/api-client",
                      "@nextbus/edge",
                      "@nextbus/mobile",
                      "@nextbus/web",
                      "react*",
                      "expo*",
                      "@expo/*",
                      "nativewind*",
                      "zustand",
                      "@tanstack/*",
                      "lucide-*"
                    ],
                    "message": "not importable from adapters — boundary declared in layers.json (ADR-051)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/edge/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nextbus/ui",
                      "@nextbus/i18n",
                      "@nextbus/api-client",
                      "@nextbus/mobile",
                      "@nextbus/web",
                      "react*",
                      "expo*",
                      "@expo/*",
                      "nativewind*",
                      "zustand",
                      "@tanstack/*",
                      "lucide-*"
                    ],
                    "message": "not importable from server — boundary declared in layers.json (ADR-051)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**", "apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nextbus/data-normalize", "@nextbus/edge"],
                    "message": "not importable from view — boundary declared in layers.json (ADR-051)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
