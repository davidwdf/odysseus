# Copy to `.env.local` (gitignored) if you need to override a default.
#
# Expo CLI loads `.env*` from THIS directory — the Expo project root — not from the repo root.
# Everything here is public by construction: the `EXPO_PUBLIC_` prefix means Expo inlines the
# value into the JavaScript bundle at build time, where any user can read it in DevTools.
# **Never put a credential behind that prefix.** If something needs a key, it goes through the
# Worker. See docs/10 "Configuration & secrets" for the full inventory.

# Base URL of the edge Worker. Defaults to http://localhost:8787 when unset, which is what
# `pnpm dev` serves. Set it to the deployed Worker for a real build — `build:web` bakes it into
# both the bundle and the service worker's runtime-caching routes (ADR-058).
EXPO_PUBLIC_API_URL=http://localhost:8787
