{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // Same two out-of-hash inputs as `apps/web`, for the same reason and with the same consequence:
      // `test/stoprow-projection.test.tsx` replays `packages/core/spec/stop-card.spec.json` against
      // `packages/contract/ui/stop-row.spec.json`, and neither is inside this package. A gate that cannot
      // see its own input passes for ever (ADR-070).
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/spec/*.spec.json",
        "$TURBO_ROOT$/packages/contract/ui/*.spec.json"
      ]
    }
  }
}
