    "searchStops": {
      "doc": "Stops and places whose name contains the query in ANY locale, so a Chinese rider and an English rider both find a stop regardless of the UI language. A prefix match ranks above a mid-string match; ties keep index order, which means a port needs a STABLE sort (Swift's `sorted(by:)` is not stable — use an index tiebreak). The query is trimmed and lower-cased on both sides. An empty query returns nothing. The operator filter, if any, is applied through the id. `expect` is the resulting ids in order.",
      "cases": [
        {
          "name": "prefix-ranks-above-mid-string",
          "why": "Both names contain 'city'; the one that STARTS with it comes first, even though it is second in the index.",
          "args": {
            "stops": [
              {
                "id": "CTB:002451",
                "name": {
                  "en": "NORTH POINT CITY",
                  "zh-Hant": "北角城",
                  "zh-Hans": "北角城"
                },
                "lat": 22.2911,
                "lng": 114.2005
              },
              {
                "id": "KMB:ST141",
                "name": {
                  "en": "CITY ONE STATION",
                  "zh-Hant": "第一城站",
                  "zh-Hans": "第一城站"
                },
                "lat": 22.3833,
                "lng": 114.2044
              }
            ],
            "query": "city",
            "locale": "en",
            "operators": [],
            "limit": 60
          },
          "expect": ["KMB:ST141", "CTB:002451"]
        },
        {
          "name": "equal-rank-keeps-index-order",
          "why": "Two prefix matches must come back in index order, which requires a STABLE sort. Swift's sort is not stable, so a naive port can flip these two and the results list reshuffles between keystrokes for no visible reason.",
