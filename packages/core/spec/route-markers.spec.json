{
  "$schema": "../../../schemas/kernel-spec.schema.json",
  "module": "route-markers",
  "source": "src/route-markers.ts",
  "version": 1,
  "doc": "What glyph each stop on a route gets, and the direction of travel through it (`docs/proposals/06 §8d`). `kind` and `index` are exact equality. `bearing` is DEGREES clockwise from north, quoted to 4 decimal places and compared with a tolerance of 1e-4 — far finer than a marker could show, so a port failing one has a real formula difference and not a rounding one. Coordinates are laid out on clean north/east legs rather than taken from a real route, because every row here is about a RULE (which glyph, which neighbour, what happens at an end) and a real route's bearings would be unreadable numbers that hid what each row was testing. The offset distance is deliberately absent — see the module doc for why it cannot live in the data.",
  "groups": {
    "routeMarkers": {
      "doc": "What glyph each stop on a route gets, where it is anchored, and the direction of travel through it (`docs/proposals/06 §8d`). `kind`, `index` and `at` are exact equality — `at` is a coordinate the renderer anchors to, so a port differing there differs on screen. `bearing` is DEGREES clockwise from north, quoted to 4 decimal places and compared with a tolerance of 1e-4, far finer than a marker could show. Coordinates are laid out on clean north/east legs rather than taken from a real route, because every row is about a RULE and a real route's bearings would be unreadable numbers that hid what each row was testing. `line` is optional: with one, stops are projected onto it (which is what keeps a marker on the road at every zoom); without one, both the anchor and the bearing fall back to the stops themselves. The offset DISTANCE is deliberately absent — see the module doc for why it cannot live in the data.",
      "cases": [
        {
