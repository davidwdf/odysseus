{
  "module": "route-path",
  "source": "src/route-path.ts",
  "version": 1,
  "doc": "The route-line resolver: which CSDI line is this route's, which way round it runs, and where it starts and ends. Conventions a port must mirror: (1) vertices are [longitude, latitude] — GeoJSON order, which is what CSDI returns, and the reverse of every LatLng in this package; (2) distances are metres via a LOCAL EQUIRECTANGULAR projection about the mean latitude of the stops, NOT the haversine — the trim step needs a planar projection and over a Hong Kong route the difference is far below these tolerances; (3) float rows compare with |actual - expected| <= tolerance, never equality; (4) a `null` fit means 'no usable fit' (the TS returns Infinity, Swift .infinity) and a `null` resolve means 'this route has no line', which is an ORDINARY answer for ~7% of route-directions, not an error. Expected values were generated by an independent Python implementation and are asserted against the TypeScript, so agreement is evidence rather than a recording of whatever the code happened to do.",
  "groups": {
    "meanStopToLineMetres": {
      "doc": "Mean distance from every stop to the nearest point on the line, metres. The score that picks a candidate. Returns no fit for an empty stop list or a degenerate line.",
      "cases": [
        {
          "name": "stops-exactly-on-the-line",
          "why": "The floor. A perfectly surveyed line through its own stops scores zero.",
          "args": {
            "stops": [[114.0, 22.32], [114.0, 22.35], [114.0, 22.38]],
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ]
          },
          "expect": {
            "metres": 0.0,
            "tolerance": 0.5
          }
        },
        {
          "name": "stops-offset-east",
          "why": "A real line is a road centreline and the stops are kerbs, so a good fit is tens of metres, not zero.",
          "args": {
            "stops": [[114.0005, 22.32], [114.0005, 22.35], [114.0005, 22.38]],
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ]
          },
          "expect": {
            "metres": 51.4209,
            "tolerance": 0.5
          }
        },
        {
          "name": "reversed-line-scores-identically",
          "why": "THE limitation that makes orientToStops necessary: this metric is direction-agnostic, so it can never decide which way a line runs.",
          "args": {
            "stops": [[114.0005, 22.32], [114.0005, 22.35], [114.0005, 22.38]],
            "line": [
              [114.0, 22.400000000000002],
              [114.0, 22.39],
              [114.0, 22.38],
              [114.0, 22.37],
              [114.0, 22.36],
              [114.0, 22.35],
              [114.0, 22.34],
              [114.0, 22.330000000000002],
              [114.0, 22.32],
              [114.0, 22.310000000000002],
              [114.0, 22.3]
            ]
          },
          "expect": {
            "metres": 51.4209,
            "tolerance": 0.5
          }
        },
        {
          "name": "wrong-route-scores-kilometres",
          "why": "What ROUTE_PATH_REJECT_METRES exists to catch on the operator+number fallback.",
          "args": {
            "stops": [[114.05, 22.32], [114.05, 22.35], [114.05, 22.38]],
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ]
          },
          "expect": {
            "metres": 5142.0883,
            "tolerance": 1.0
          }
        },
        {
          "name": "no-stops-has-no-fit",
          "why": "A candidate must never win on missing evidence.",
          "args": {
            "stops": [],
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ]
          },
          "expect": {
            "metres": null,
            "tolerance": 0
          }
        },
        {
          "name": "single-vertex-line-has-no-fit",
          "why": "A point is not a path and must not be drawn as one.",
          "args": {
            "stops": [[114.0, 22.32], [114.0, 22.35], [114.0, 22.38]],
            "line": [[114.0, 22.35]]
          },
          "expect": {
            "metres": null,
            "tolerance": 0
          }
        }
      ]
    },
    "nearestOnPath": {
      "doc": "Where a point lands on a polyline: segment index, position along it (0..1), and distance in metres.",
      "cases": [
        {
          "name": "mid-segment",
          "why": "The projection must land part-way along a segment, not snap to a vertex — a terminus mid-segment would otherwise leave a stub after trimming.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "point": [114.0005, 22.325]
          },
          "expect": {
            "index": 2,
            "t": 0.5,
            "distanceMetres": 51.4301,
            "tolerance": 0.5
          }
        },
        {
          "name": "on-the-first-vertex",
          "why": "Boundary: t clamps to 0 rather than going negative.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "point": [114.0, 22.3]
          },
          "expect": {
            "index": 0,
            "t": 0.0,
            "distanceMetres": 0.0,
            "tolerance": 0.5
          }
        },
        {
          "name": "degenerate-line",
          "why": "Fewer than two vertices is not a path.",
          "args": {
            "line": [[114.0, 22.3]],
            "point": [114.0, 22.3]
          },
          "expect": null
        }
      ]
    },
    "orientToStops": {
      "doc": "Reverse a line when its vertices run against the rider's stop order. This — never ROUTE_SEQ — is what makes a direction correct.",
      "cases": [
        {
          "name": "already-forward",
          "why": "No change when the line already runs the rider's way.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "first": [114.0, 22.32],
            "last": [114.0, 22.38]
          },
          "expect": {
            "reversed": false
          }
        },
        {
          "name": "line-runs-backwards",
          "why": "The trap hkbus records as issue #14: CSDI's vertex order does not track the operator's outbound/inbound.",
          "args": {
            "line": [
              [114.0, 22.400000000000002],
              [114.0, 22.39],
              [114.0, 22.38],
              [114.0, 22.37],
              [114.0, 22.36],
              [114.0, 22.35],
              [114.0, 22.34],
              [114.0, 22.330000000000002],
              [114.0, 22.32],
              [114.0, 22.310000000000002],
              [114.0, 22.3]
            ],
            "first": [114.0, 22.32],
            "last": [114.0, 22.38]
          },
          "expect": {
            "reversed": true
          }
        },
        {
          "name": "decided-by-both-terminals-not-one-vertex",
          "why": "hkbus compares the line's first vertex to the direction's first stop. Here both terminals sit near the SAME end of the line, which a one-point test gets wrong and a two-point test does not.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "first": [114.0, 22.31],
            "last": [114.0, 22.315]
          },
          "expect": {
            "reversed": false
          }
        }
      ]
    },
    "trimPathToStops": {
      "doc": "Cut a line down to the stretch between the rider's own first and last stop. Assumes the line is already oriented.",
      "cases": [
        {
          "name": "trims-both-ends",
          "why": "The step that makes variant selection stop mattering — no tail past the terminus the rider is looking at.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "first": [114.0, 22.32],
            "last": [114.0, 22.38]
          },
          "expect": {
            "pathFirst": [114.0, 22.32],
            "pathLast": [114.0, 22.38],
            "pathLength": 8,
            "trimmedStart": 2,
            "trimmedEnd": 3,
            "tolerance": 1e-5
          }
        },
        {
          "name": "circular-route-keeps-the-whole-line",
          "why": "Both terminals project to nearly the same place; trimming there would erase the route. A circular must survive.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "first": [114.0, 22.35],
            "last": [114.0, 22.3505]
          },
          "expect": {
            "pathFirst": [114.0, 22.3],
            "pathLast": [114.0, 22.4],
            "pathLength": 11,
            "trimmedStart": 0,
            "trimmedEnd": 0,
            "tolerance": 1e-5
          }
        }
      ]
    },
    "resolveRoutePath": {
      "doc": "Pick this route's line, orient it, trim it. Returns nothing when there is no usable candidate — an ordinary answer for ~7% of bus and minibus route-directions.",
      "cases": [
        {
          "name": "single-good-candidate",
          "why": "The happy path: chosen, oriented, trimmed to the rider's terminals.",
          "args": {
            "stops": [[114.0005, 22.32], [114.0005, 22.35], [114.0005, 22.38]],
            "candidates": [
              {
                "id": "1001",
                "seq": 1,
                "matchedBy": "gtfsId",
                "line": [
                  [114.0, 22.3],
                  [114.0, 22.310000000000002],
                  [114.0, 22.32],
                  [114.0, 22.330000000000002],
                  [114.0, 22.34],
                  [114.0, 22.35],
                  [114.0, 22.36],
                  [114.0, 22.37],
                  [114.0, 22.38],
                  [114.0, 22.39],
                  [114.0, 22.400000000000002]
                ]
              }
            ]
          },
          "expect": {
            "id": "1001",
            "matchedBy": "gtfsId",
            "fitMetres": 51.4209,
            "reversed": false,
            "trimmedStart": 2,
            "trimmedEnd": 3,
            "pathFirst": [114.0, 22.32],
            "pathLast": [114.0, 22.38],
            "pathLength": 8,
            "tolerance": 0.5
          }
        },
        {
          "name": "reversed-candidate-is-oriented",
          "why": "A line whose vertices run backwards is still this route's line — reverse it, do not reject it.",
          "args": {
            "stops": [[114.0005, 22.32], [114.0005, 22.35], [114.0005, 22.38]],
            "candidates": [
              {
                "id": "1001r",
                "seq": 2,
                "matchedBy": "gtfsId",
                "line": [
                  [114.0, 22.400000000000002],
                  [114.0, 22.39],
                  [114.0, 22.38],
                  [114.0, 22.37],
                  [114.0, 22.36],
                  [114.0, 22.35],
                  [114.0, 22.34],
                  [114.0, 22.330000000000002],
                  [114.0, 22.32],
                  [114.0, 22.310000000000002],
                  [114.0, 22.3]
                ]
              }
            ]
          },
          "expect": {
            "id": "1001r",
            "matchedBy": "gtfsId",
            "fitMetres": 51.4209,
            "reversed": true,
            "trimmedStart": 2,
            "trimmedEnd": 3,
            "pathFirst": [114.0, 22.32],
            "pathLast": [114.0, 22.38],
            "pathLength": 8,
            "tolerance": 0.5
          }
        },
        {
          "name": "best-of-several-wins",
          "why": "The operator+number fallback can offer several ROUTE_IDs; NLB route 1 matches five. The one that covers the rider's stops wins.",
          "args": {
            "stops": [[114.0005, 22.32], [114.0005, 22.35], [114.0005, 22.38]],
            "candidates": [
              {
                "id": "9999",
                "seq": 1,
                "matchedBy": "routeNumber",
                "line": [[114.0, 22.3], [114.0, 22.34], [114.02, 22.34], [114.02, 22.4]]
              },
              {
                "id": "1001",
                "seq": 1,
                "matchedBy": "gtfsId",
                "line": [
                  [114.0, 22.3],
                  [114.0, 22.310000000000002],
                  [114.0, 22.32],
                  [114.0, 22.330000000000002],
                  [114.0, 22.34],
                  [114.0, 22.35],
                  [114.0, 22.36],
                  [114.0, 22.37],
                  [114.0, 22.38],
                  [114.0, 22.39],
                  [114.0, 22.400000000000002]
                ]
              }
            ]
          },
          "expect": {
            "id": "1001",
            "matchedBy": "gtfsId",
            "fitMetres": 51.4209,
            "reversed": false,
            "trimmedStart": 2,
            "trimmedEnd": 3,
            "pathFirst": [114.0, 22.32],
            "pathLast": [114.0, 22.38],
            "pathLength": 8,
            "tolerance": 0.5
          }
        },
        {
          "name": "all-candidates-rejected",
          "why": "A wrong route from the name fallback must produce no line rather than a plausible-looking wrong one.",
          "args": {
            "stops": [[114.05, 22.32], [114.05, 22.35], [114.05, 22.38]],
            "candidates": [
              {
                "id": "1001",
                "seq": 1,
                "matchedBy": "gtfsId",
                "line": [
                  [114.0, 22.3],
                  [114.0, 22.310000000000002],
                  [114.0, 22.32],
                  [114.0, 22.330000000000002],
                  [114.0, 22.34],
                  [114.0, 22.35],
                  [114.0, 22.36],
                  [114.0, 22.37],
                  [114.0, 22.38],
                  [114.0, 22.39],
                  [114.0, 22.400000000000002]
