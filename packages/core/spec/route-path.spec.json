          }
        }
      ]
    },
    "nearestOnPath": {
      "doc": "Where a point lands on a polyline: segment index, position along it (0..1), and distance in metres.",
      "cases": [
        {
          "name": "mid-segment",
          "why": "The projection must land part-way along a segment, not snap to a vertex — a terminus mid-segment would otherwise leave a stub after trimming.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "point": [114.0005, 22.325]
          },
          "expect": {
            "index": 2,
            "t": 0.5,
            "distanceMetres": 51.4301,
            "tolerance": 0.5
          }
        },
        {
          "name": "on-the-first-vertex",
          "why": "Boundary: t clamps to 0 rather than going negative.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "point": [114.0, 22.3]
          },
          "expect": {
            "index": 0,
            "t": 0.0,
            "distanceMetres": 0.0,
            "tolerance": 0.5
          }
        },
        {
          "name": "degenerate-line",
          "why": "Fewer than two vertices is not a path.",
          "args": {
            "line": [[114.0, 22.3]],
            "point": [114.0, 22.3]
          },
          "expect": null
        },
        {
          "name": "a-repeated-vertex-makes-a-segment-with-no-length",
          "why": "Upstream lines do carry duplicated consecutive vertices, and a zero-length segment divides by its own squared length. Without the guard this is a NaN that propagates into every distance, silently poisoning the fit score that picks a route — so the guard answers the distance to the point itself, at `t = 0`. The projection lands on the vertex either way, which is why the row asserts the SEGMENT it chose.",
          "args": {
            "line": [[114.0, 22.3], [114.0, 22.32], [114.0, 22.32], [114.0, 22.34]],
            "point": [114.0005, 22.32]
          },
          "expect": {
            "index": 0,
            "t": 1.0,
            "distanceMetres": 51.4319,
            "tolerance": 0.5
          }
        }
      ]
    },
    "orientToStops": {
      "doc": "Reverse a line when its vertices run against the rider's stop order. This — never ROUTE_SEQ — is what makes a direction correct.",
      "cases": [
        {
          "name": "already-forward",
          "why": "No change when the line already runs the rider's way.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "first": [114.0, 22.32],
            "last": [114.0, 22.38]
          },
          "expect": {
            "reversed": false
          }
        },
        {
          "name": "line-runs-backwards",
          "why": "The trap hkbus records as issue #14: CSDI's vertex order does not track the operator's outbound/inbound.",
          "args": {
            "line": [
              [114.0, 22.400000000000002],
              [114.0, 22.39],
              [114.0, 22.38],
              [114.0, 22.37],
              [114.0, 22.36],
              [114.0, 22.35],
              [114.0, 22.34],
              [114.0, 22.330000000000002],
              [114.0, 22.32],
              [114.0, 22.310000000000002],
              [114.0, 22.3]
            ],
            "first": [114.0, 22.32],
            "last": [114.0, 22.38]
          },
          "expect": {
            "reversed": true
          }
        },
        {
          "name": "decided-by-both-terminals-not-one-vertex",
          "why": "hkbus compares the line's first vertex to the direction's first stop. Here both terminals sit near the SAME end of the line, which a one-point test gets wrong and a two-point test does not.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "first": [114.0, 22.31],
            "last": [114.0, 22.315]
          },
          "expect": {
            "reversed": false
          }
        },
        {
          "name": "a-line-too-short-to-project-onto-is-returned-untouched",
          "why": "A one-vertex line has no segment, so `nearestOnPath` has nothing to answer and orientation is unanswerable. Returning it unchanged and unreversed is the only honest option — and this is the row that exercises the guard at all, which went unwritten because the module sat outside the coverage threshold (ADR-155).",
          "args": {
            "line": [[114.0, 22.32]],
            "first": [114.0, 22.32],
            "last": [114.0, 22.38]
          },
          "expect": {
            "reversed": false
          }
        }
      ]
    },
    "trimPathToStops": {
      "doc": "Cut a line down to the stretch between the rider's own first and last stop. Assumes the line is already oriented.",
      "cases": [
        {
          "name": "trims-both-ends",
          "why": "The step that makes variant selection stop mattering — no tail past the terminus the rider is looking at.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "first": [114.0, 22.32],
            "last": [114.0, 22.38]
          },
          "expect": {
            "pathFirst": [114.0, 22.32],
            "pathLast": [114.0, 22.38],
            "pathLength": 8,
            "trimmedStart": 2,
            "trimmedEnd": 3,
            "tolerance": 1e-5
          }
        },
        {
          "name": "circular-route-keeps-the-whole-line",
          "why": "Both terminals project to nearly the same place; trimming there would erase the route. A circular must survive.",
          "args": {
            "line": [
              [114.0, 22.3],
              [114.0, 22.310000000000002],
              [114.0, 22.32],
              [114.0, 22.330000000000002],
              [114.0, 22.34],
              [114.0, 22.35],
              [114.0, 22.36],
              [114.0, 22.37],
              [114.0, 22.38],
              [114.0, 22.39],
              [114.0, 22.400000000000002]
            ],
            "first": [114.0, 22.35],
            "last": [114.0, 22.3505]
          },
          "expect": {
            "pathFirst": [114.0, 22.3],
            "pathLast": [114.0, 22.4],
            "pathLength": 11,
            "trimmedStart": 0,
            "trimmedEnd": 0,
            "tolerance": 1e-5
          }
        },
        {
          "name": "a-line-too-short-to-project-onto-is-kept-whole",
          "why": "The same shape as `orientToStops`, and it must give the same answer: nothing to cut, nothing cut. This used to be reached by a `line.length < 2` test of its own, which could never fire because `nearestOnPath` already answers `null` for exactly that case — one guard now, and this row is what proves it still covers the short line.",
          "args": {
            "line": [[114.0, 22.32]],
            "first": [114.0, 22.32],
            "last": [114.0, 22.38]
          },
          "expect": {
            "pathFirst": [114.0, 22.32],
            "pathLast": [114.0, 22.32],
            "pathLength": 1,
            "trimmedStart": 0,
            "trimmedEnd": 0,
            "tolerance": 1e-5
          }
        }
      ]
    },
