        {
          "name": "no-candidates",
          "why": "~7% of route-directions. Not an error.",
          "args": {
            "stops": [[114.0005, 22.32], [114.0005, 22.35], [114.0005, 22.38]],
            "candidates": []
          },
          "expect": null
        },
        {
          "name": "one-stop-is-not-a-route",
          "why": "Two stops are the minimum evidence for orientation.",
          "args": {
            "stops": [[114.0005, 22.32]],
            "candidates": [
              {
                "id": "1001",
                "seq": 1,
                "matchedBy": "gtfsId",
                "line": [
                  [114.0, 22.3],
                  [114.0, 22.310000000000002],
                  [114.0, 22.32],
                  [114.0, 22.330000000000002],
                  [114.0, 22.34],
                  [114.0, 22.35],
                  [114.0, 22.36],
                  [114.0, 22.37],
                  [114.0, 22.38],
                  [114.0, 22.39],
                  [114.0, 22.400000000000002]
                ]
              }
            ]
          },
          "expect": null
        }
      ]
    }
  }
}
