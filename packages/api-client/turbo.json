{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // This package's suite asserts the output of **kernel** functions — `applyLiveFrame`, `diffEtas`,
      // `acceptTargets`, `liveSocketUrl` — as it arrives through the transports. It does depend on
      // `@nextbus/core`, but the root `test` task declares no `dependsOn`, so a package's test hash covers
      // only its own files: a change to `packages/core/src/live.ts` that broke the reduced ordering would
      // replay a stale pass here. The same shape `packages/contract`, `apps/mobile` and `apps/web` each
      // declare for the corpus they read across the package boundary.
      //
      // Declared rather than `cache: false` for the reason `packages/contract/turbo.json` gives: stating
      // what a task reads is more useful to the next reader than switching the cache off, and the cache
      // keeps working.
      //
      // The `fixtures/` glob is WP5-5's: `test/live-rounds.test.ts` reads
      // `@nextbus/core/fixtures/live-rounds.json`, whose whole purpose is that `apps/edge` reads the same
      // bytes. A row edited to describe new behaviour with this suite replaying a cached pass would be
      // ADR-070's failure in the one place it hurts most — the two engines would stop being compared and
      // the build would stay green.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/src/*.ts",
        "$TURBO_ROOT$/packages/core/fixtures/*"
      ]
    }
  }
}
