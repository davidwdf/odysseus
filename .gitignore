# dependencies
node_modules/
.pnpm-store/

# builds / outputs
dist/
build/
web-build/
*.tsbuildinfo

# turbo
.turbo/

# expo / react-native (managed workflow: native dirs are generated)
.expo/
ios/
android/
*.orig.*

# cloudflare workers
.wrangler/
.dev.vars

# env & logs
.env
.env.*
!.env.example
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Precomputed dataset builds (pnpm dataset:build) — large, reproducible, never committed.
apps/edge/.dataset/

# Coverage output (pnpm test in packages/core enforces a branch threshold — WP1-5).
coverage/

# Boundary self-test scratch: selftest.mjs writes a derived Biome config into a fixture, then
# deletes it. Ignored so a killed run cannot leave the tree dirty.
scripts/boundaries/fixtures/*/biome.json
